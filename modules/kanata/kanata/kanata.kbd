(defsrc
  1 2 3 4 5 6 7 8 9 0 - =
  q w e r t y u i o p [ ]
  a s d f g h j k l ; '
  z x c v b n m , . /
)

(deflayer qwerty
  1 2 3 4 5 6 7 8 9 0 - =
  q w e r t y u i o p [ ]
  a s d f g h j k l ; '
  z x c v b n _ , . /
)

(deflayer colemakdh
  1 2 3 4 5 6 7 8 9 0 - =
  q w f p b j l u y ; [ ]
  a r s t g m n e i o '
  z x c d v k h , . /
)

(deflayer dvorak
  1 2 3 4 5 6 7 8 9 0 [ ]
  ' , . p y f g c r l / =
  a o e u i d h t n s -
  ; q j k x b _ w v z
)

(defcfg
  process-unmapped-keys   yes
  concurrent-tap-hold     yes
  allow-hardware-repeat   no
)

(defchordsv2
  (m 0) (layer-switch qwerty) 300 all-released ()
  (m 5) (layer-switch colemakdh) 300 all-released ()
  (m 6) (layer-switch dvorak) 300 all-released ()
)

